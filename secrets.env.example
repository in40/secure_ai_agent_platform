# Copy to secrets.env (chmod 600) and fill real values. Never commit secrets.env.
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_SECRET_KEY=
VERIAGENT_JUDGE_KEY=
VERIAGENT_SIGNING_KEY=
POSTGRES_PASSWORD=
LANGFLOW_DATABASE_URL=postgresql://langflow:CHANGE_ME@postgres:5432/langflow
# OTLP auth header for tracing exporter, e.g. Authorization=Basic <base64 user:pass>
OTEL_EXPORTER_OTLP_HEADERS=
# --- Tyk / vLLM (компонент TYK vLLM Model) ---
VLLM_API_BASE=
VLLM_EPA_AUTH=true
EPA__BASE_URL=
EPA__CLIENT_ID=
EPA__CLIENT_SECRET=
# вторая+модели в dropdown через запятую (первая qwen3.5-27b-q8-mtp-vision вшита):
#VLLM_MODEL_CHOICES=
# подробная EPA-диагностика в docker logs:
#VLLM_EPA_DEBUG=true
# внутренний CA / тикетный контур:
#VLLM_SSL_VERIFY=false
#VLLM_ASYNC_ENABLED=true
