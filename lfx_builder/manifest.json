{
  "features": {
    "docling_core": {
      "description": "Docling Inline + Chunk DoclingDocument (torch stack + layout/table models)",
      "pip": ["docling", "docling-slim", "docling-core", "docling-ibm-models", "docling-parse", "torch", "torchvision", "transformers", "accelerate", "opencv-python", "opencv-python-headless"],
      "paths": ["/app/data/.cache/docling", "/app/data/.cache/huggingface"],
      "match_types": ["doclinginline", "chunkdoclingdocument", "doclingdocument"]
    },
    "ocr_easyocr": {
      "description": "EasyOCR engine + models",
      "pip": ["easyocr"],
      "paths": ["/app/data/.cache/docling/models/EasyOcr"],
      "field_rule": { "type": "doclinginline", "field": "ocr_engine", "values": ["easyocr"] }
    },
    "ocr_tesseract": {
      "description": "tesserocr + tessdata",
      "pip": ["tesserocr"],
      "paths": ["/usr/share/tessdata"],
      "field_rule": { "type": "doclinginline", "field": "ocr_engine", "values": ["tesserocr"] }
    },
    "ocr_rapidocr": {
      "description": "rapidocr + onnxruntime",
      "pip": ["rapidocr", "rapidocr-onnxruntime", "onnxruntime"],
      "field_rule": { "type": "doclinginline", "field": "ocr_engine", "values": ["rapidocr"] }
    },
    "piccls": {
      "description": "DocumentFigureClassifier model",
      "paths": ["/app/data/.cache/huggingface/hub/models--docling-project--DocumentFigureClassifier-v2.5"],
      "field_rule": { "type": "doclinginline", "field": "do_picture_classification", "values": ["true", "True", true] }
    },
    "libreoffice": {
      "description": "LibreOffice for legacy doc/ppt/xls (kept whenever Docling Inline present — input types unknown upfront; drop with --no-lo)",
      "paths": ["/opt/libreoffice26.8", "/usr/bin/soffice"],
      "match_types": ["doclinginline"]
    },
    "pdfplumber": {
      "description": "pdfplumber package",
      "pip": ["pdfplumber", "pdfminer.six"],
      "match_types": ["pdfplumber"]
    },
    "neo4j": {
      "description": "neo4j driver",
      "pip": ["neo4j"],
      "match_types": ["neo4j", "graphedit", "graphviewer"]
    },
    "calamine": {
      "description": "Excel parser",
      "pip": ["python-calamine"],
      "match_types": ["excel"]
    },
    "uv_cache": {
      "description": "uv build cache (never needed at runtime)",
      "paths": ["/app/data/.cache/uv"],
      "always_remove": true
    },
    "other_providers": {
      "description": "SDK провайдеров, которых нет в flow: IBM/watsonx, Google, Azure, AWS, Anthropic, Cohere, Mistral, Ollama, Slack, Groq + pyright",
      "pip": ["anthropic", "azure-ai-contentsafety", "azure-ai-contentunderstanding", "azure-ai-projects", "azure-core", "azure-identity", "azure-search-documents", "azure-storage-blob", "msal", "msal-extensions", "boto3", "boto3-stubs", "botocore", "botocore-stubs", "cohere", "google-api-core", "google-api-python-client", "google-auth", "google-auth-httplib2", "google-auth-oauthlib", "google-cloud-bigquery", "google-cloud-core", "google-cloud-modelarmor", "google-crc32c", "google-genai", "google-resumable-media", "ibm-cloud-sdk-core", "ibm-cos-sdk", "ibm-cos-sdk-core", "ibm-cos-sdk-s3transfer", "clidriver", "watsonx-ai", "ollama", "slack-sdk", "mistralai", "groq", "pyright"],
      "match_types": ["amazon", "bedrock", "sagemaker", "google", "gemini", "vertex", "azure", "ai_foundry", "watsonx", "ibm", "anthropic", "claude", "slack", "ollama", "openrouter", "mistral", "cohere", "groq"]
    }
  },
  "known_base_types": [
    "chatinput", "chatoutput", "language", "prompt template", "promptcomponent",
    "parsercomponent", "parser", "uploadedfile", "doclingremote", "splittext",
    "file", "url", "memory", "openaiembedding", "embeddings", "vectorsearch",
    "qdrant", "sqlconnector", "apiretriever", "conditionalrouter", "subworkflow",
    "veriagent", "chatsession", "storemessage", "getmessage", "advancedprompt",
    "languagemodelcomponent", "doclingremotecomponent", "chatinputcomponent",
    "chatoutputcomponent", "parsercomponent", "webhook", "receive", "sendhttprequest",
    "note", "calculatorcomponent", "agent", "urlcomponent", "multilineinput",
    "textinput", "booleaninput", "dropdown", "tablecomponent", "dataframe",
    "documentprompt", "loopcomponent", "mcptools", "recursivecharactertextsplitter",
    "typeconvertercomponent", "vllmmodel", "splittextcomponent", "filterdataframe",
    "sqlconnectorcomponent", "watchfile"
  ],
  "services": {
    "_note": "см. RUNTIME_SERVICES.md — сопоставление 'нода flow → локальный сервис в LFX'",
    "qdrant":   {"match_types": ["qdrant"], "port": 6333, "mode": "in-memory по умолчанию"},
    "embedder": {"match_types": ["embeddingmodel"], "port": 8081, "model": "user-bge-m3-q8_0.gguf (совпадать с индексом!)"},
    "reranker": {"match_types": ["rerankcomponent"], "port": 8082, "model": "bge-reranker-v2-m3-Q4_K_M.gguf (stateless)"}
  },
  "base_custom_types": [
    "tykvllmmodel", "doclingremote", "uploadedfile", "pdfplumbercomponent",
    "chatinputrouter", "veriagentinputguard", "veriagenttoolguard", "veriagentgroundingguard"
  ],
  "import_map": {
    "httpx": "", "openai": "", "langflow": "", "lfx": "", "langchain": "",
    "langchain_core": "", "langchain_openai": "", "pydantic": "", "pydantic_settings": "",
    "loguru": "", "fastapi": "", "starlette": "", "jinja2": "", "yaml": "", "dotenv": "",
    "docling": "docling", "docling_core": "docling-core", "torch": "torch", "torchvision": "torch",
    "transformers": "transformers", "easyocr": "easyocr", "tesserocr": "tesserocr",
    "rapidocr": "rapidocr", "rapidocr_onnxruntime": "rapidocr-onnxruntime", "onnxruntime": "onnxruntime",
    "pdfplumber": "pdfplumber", "pdfminer": "pdfminer.six", "neo4j": "neo4j",
    "calamine": "python-calamine", "cv2": "opencv-python-headless", "PIL": "pillow",
    "fitz": "pymupdf", "pymupdf": "pymupdf", "bs4": "beautifulsoup4", "docx": "python-docx",
    "openpyxl": "openpyxl", "pandas": "pandas", "numpy": "numpy", "requests": "requests",
    "sklearn": "scikit-learn", "scipy": "scipy", "matplotlib": "matplotlib",
    "pptx": "python-pptx", "reportlab": "reportlab", "markdown": "", "sqlalchemy": "",
    "psycopg": "", "psycopg2": "", "boto3": "", "google": "", "azure": "", "mistralai": ""
  }
}
